{% extends "_layout.njk" %}

{% block content %}
{% from "_macro/folio.njk" import directory_title with context %}
{% from "_macro/archive.njk" import render_list with context %}
<section class="folio-directory">
    {% set period = archive_period(page) %}
    {{ directory_title(__('nav.archives'), period if period else '') }}

    {% set posts = page.posts.sort('date', -1) %}

    {% if posts.length > 0 %}
        {{ render_list(posts) }}
    {% else %}
        {% include "_partial/common/empty.njk" %}
    {% endif %}

    {% include "_partial/common/pagination.njk" %}
</section>
{% endblock %}
