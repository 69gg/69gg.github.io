{% extends "_guestbook_layout.njk" %}
{% from "_macro/ui.njk" import icon_theme_system, icon_theme_light, icon_theme_dark with context %}

{% block content %}
<section class="noticeboard" aria-labelledby="noticeboard-title">
    <script type="application/json" id="noticeboard-config">{{ js_value({ apiUrl: config.theme_config.guestbook.api_url, repository: config.theme_config.comments.giscus.repo, discussionNumber: config.theme_config.guestbook.discussion_number, refreshInterval: config.theme_config.guestbook.refresh_interval, zoom: config.theme_config.guestbook.zoom }) | safe }}</script>
    <header class="noticeboard-heading">
        <a href="/" class="noticeboard-home"><span aria-hidden="true">←</span> 回首页</a>
        <h1 id="noticeboard-title">{{ escape_html(page.title) }}</h1>
        <div class="noticeboard-controls">
            {% if gates.darkModeToggle %}
            <button id="themeToggle" type="button" class="folio-icon-button" aria-label="{{ escape_attr(__('theme.' + gates.darkModeDefault)) }}" data-label-system="{{ escape_attr(__('theme.system')) }}" data-label-light="{{ escape_attr(__('theme.light')) }}" data-label-dark="{{ escape_attr(__('theme.dark')) }}" disabled>{{ icon_theme_system() }}{{ icon_theme_light() }}{{ icon_theme_dark() }}</button>
            {% endif %}
            <button type="button" class="noticeboard-write" id="noticeboard-write" disabled><span aria-hidden="true">＋</span> 贴纸条</button>
        </div>
    </header>
    <div class="noticeboard-toolbar" data-pagefind-ignore>
        {% include "_partial/comments/network-hint.njk" %}
        <div class="noticeboard-count"><span id="noticeboard-count">加载中…</span><span id="noticeboard-count-detail"></span><span id="noticeboard-mode"></span></div>
        <div class="noticeboard-toolbar-actions">
            <div class="noticeboard-zoom" role="group" aria-label="画布缩放">
                <button type="button" id="noticeboard-zoom-out" aria-label="缩小画布" title="缩小（Ctrl + −）">−</button>
                <button type="button" id="noticeboard-zoom-reset" aria-label="还原为原始大小" title="还原为 100%">100% · 还原</button>
                <button type="button" id="noticeboard-zoom-in" aria-label="放大画布" title="放大（Ctrl + ＋）">＋</button>
            </div>
            <div class="noticeboard-account"><span id="noticeboard-user"></span><button type="button" id="noticeboard-login" disabled>登录 GitHub</button><button type="button" id="noticeboard-logout" hidden>退出</button></div>
            <button type="button" id="noticeboard-refresh" class="noticeboard-center folio-icon-button" aria-label="刷新留言" title="刷新留言" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6.1 7a7 7 0 0 1 11.8-1L20 9M4 15l2.1 3A7 7 0 0 0 17.9 17"/></svg></button>
            <button type="button" id="noticeboard-center" class="noticeboard-center folio-icon-button" aria-label="回到画布中心" title="回到画布中心"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
    </div>
    <div class="noticeboard-viewport" id="noticeboard-viewport" tabindex="0" aria-label="留言画布，拖动空白处或使用方向键移动视角，Ctrl 加减号缩放" aria-busy="true" data-pagefind-ignore>
        <div class="noticeboard-wallpaper" id="noticeboard-wallpaper" aria-hidden="true"></div>
        <div class="noticeboard-canvas" id="noticeboard-canvas">
            <div class="noticeboard-decoration" aria-hidden="true">
                <div class="noticeboard-flowers" id="noticeboard-flowers"></div>
            </div>
            <div id="noticeboard-notes" hidden></div>
            <div class="noticeboard-petals" id="noticeboard-petals" aria-hidden="true"></div>
        </div>
    </div>
    <div class="noticeboard-sidebar-edge" id="noticeboard-sidebar-edge" aria-hidden="true"></div>
    <button type="button" class="noticeboard-sidebar-toggle folio-icon-button" id="noticeboard-sidebar-toggle" aria-label="展开纸条列表" title="纸条列表" aria-expanded="false" aria-controls="noticeboard-sidebar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5h12M9 12h12M9 19h12M3 5h1M3 12h1M3 19h1"/></svg></button>
    <aside class="noticeboard-sidebar" id="noticeboard-sidebar" aria-labelledby="noticeboard-sidebar-title" inert data-pagefind-ignore>
        <div class="noticeboard-sidebar-heading"><h2 id="noticeboard-sidebar-title">纸条列表</h2><button type="button" id="noticeboard-sidebar-close" aria-label="收起纸条列表">×</button></div>
        <div class="noticeboard-sidebar-content" id="noticeboard-sidebar-content"><p id="noticeboard-list-empty">加载纸条列表中…</p><div id="noticeboard-list"></div></div>
    </aside>
    <p id="noticeboard-loading" class="noticeboard-loading" role="status" hidden data-pagefind-ignore>
        <span class="noticeboard-loading-label"><span class="noticeboard-spinner" aria-hidden="true"></span><span id="noticeboard-loading-message">加载留言中…</span></span>
        <span class="noticeboard-loading-hint">如果长时间加载，请开启代理（梯子）后刷新重试。</span>
    </p>
    <p id="noticeboard-status" class="noticeboard-status" role="status" aria-live="polite" data-pagefind-ignore></p>
    <noscript><p class="noticeboard-status">启用 JavaScript 后，可以查看和张贴纸条。</p></noscript>
</section>

<dialog class="noticeboard-dialog" id="noticeboard-editor" data-color="cream" aria-labelledby="noticeboard-editor-title" data-pagefind-ignore>
    <form id="noticeboard-form">
        <div class="noticeboard-dialog-heading"><h2 id="noticeboard-editor-title">写张纸条</h2><button type="button" class="noticeboard-close" data-close="noticeboard-editor" aria-label="关闭">×</button></div>
        <p class="noticeboard-reply-context" id="noticeboard-editor-context" hidden></p>
        <label class="sr-only" for="noticeboard-body">纸条内容</label>
        <textarea id="noticeboard-body" name="body" rows="7" placeholder="今天有什么想说的？" aria-describedby="noticeboard-editor-markdown" required></textarea>
        <p class="noticeboard-markdown-hint" id="noticeboard-editor-markdown">支持 Markdown</p>
        <fieldset class="noticeboard-colors"><legend>挑一张纸</legend>
            <div class="noticeboard-color-options">
            {% for color in [{ key: 'cream', name: '米白' }, { key: 'rose', name: '浅粉' }, { key: 'sage', name: '浅绿' }, { key: 'blue', name: '浅蓝' }, { key: 'lilac', name: '浅紫' }] %}
            <label class="noticeboard-color" data-color="{{ color.key }}"><input type="radio" name="color" value="{{ color.key }}"{% if loop.first %} checked{% endif %}><span class="noticeboard-color-chip" aria-hidden="true"></span><span>{{ color.name }}</span></label>
            {% endfor %}
            <label class="noticeboard-color" id="noticeboard-custom-color"><input type="radio" name="color" value="custom"><span class="noticeboard-color-chip" aria-hidden="true"></span><span>自定义</span></label>
            </div>
            <label class="noticeboard-hex" for="noticeboard-color-hex"><span>HEX 颜色</span><input id="noticeboard-color-hex" type="text" inputmode="text" pattern="#?([a-fA-F0-9]{3}|[a-fA-F0-9]{6})" maxlength="7" placeholder="#RRGGBB" autocomplete="off" spellcheck="false" required disabled></label>
        </fieldset>
        <fieldset class="noticeboard-geometry"><legend>纸条外形</legend>
            <div class="noticeboard-geometry-controls">
                <label for="noticeboard-width"><span>宽度</span><input id="noticeboard-width" name="width" type="range" min="260" max="560" step="10"><output for="noticeboard-width"></output></label>
                <label for="noticeboard-height"><span>高度</span><input id="noticeboard-height" name="height" type="range" min="300" max="760" step="10"><output for="noticeboard-height"></output></label>
                <label for="noticeboard-rotation"><span>倾斜</span><input id="noticeboard-rotation" name="rotation" type="range" min="-12" max="12" step="1"><output for="noticeboard-rotation"></output></label>
            </div>
            <div class="noticeboard-geometry-preview" aria-hidden="true"><div class="noticeboard-preview-paper"><span class="board-note-pin"></span><p id="noticeboard-preview-body"></p></div></div>
        </fieldset>
        <p class="noticeboard-sizing-hint">内容较长时，纸张会自动延长。</p>
        <div class="noticeboard-dialog-actions"><button type="button" data-close="noticeboard-editor">先收起来</button><button class="noticeboard-submit" id="noticeboard-submit" type="submit">贴上去</button></div>
        <p class="noticeboard-form-status" id="noticeboard-form-status" role="status"></p>
    </form>
</dialog>

<dialog class="noticeboard-dialog noticeboard-delete-dialog" id="noticeboard-delete" aria-labelledby="noticeboard-delete-title" data-pagefind-ignore>
    <form id="noticeboard-delete-form"><h2 id="noticeboard-delete-title">移除这张纸条？</h2><p id="noticeboard-delete-description">纸条及其下面的回复都会删除。</p><div class="noticeboard-dialog-actions"><button type="button" data-close="noticeboard-delete">留下它</button><button type="submit" class="noticeboard-submit">移除</button></div></form>
</dialog>

<div class="noticeboard-dialog noticeboard-reaction-picker" id="noticeboard-reaction-picker" popover="auto" role="group" aria-label="选择表情回应" data-pagefind-ignore></div>
{% endblock %}
