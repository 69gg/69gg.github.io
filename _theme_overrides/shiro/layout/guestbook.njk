{% extends "_layout.njk" %}

{% block content %}
<article class="folio-article folio-guestbook">
    <header class="folio-article-header">
        <h1 class="page-title" data-pagefind-body data-pagefind-meta="title">{{ escape_html(page.title) }}</h1>
        <div class="folio-guestbook-intro prose-shiro" data-pagefind-body>{{ page.content | safe }}</div>
    </header>
    {% if gates.needsComments %}
    {% include "_partial/comments/index.njk" %}
    {% endif %}
</article>
{% endblock %}
