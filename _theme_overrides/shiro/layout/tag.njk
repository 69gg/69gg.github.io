{% extends "_layout.njk" %}
{% from "_macro/folio.njk" import directory_title with context %}
{% from "_macro/archive.njk" import render_list with context %}

{% block content %}
<section class="folio-directory">
    {{ directory_title(__('nav.tags'), page.tag) }}

    {% if is_tag() %}
        {# Use Hexo paginated page.posts (honours per_page), not the full tag collection. #}
        {% include "_partial/common/paginated-posts.njk" %}
    {% else %}
        {% if site.tags.length > 0 %}
        <nav class="folio-tag-cloud" aria-label="{{ escape_attr(__('nav.tags')) }}">
            {{ tagcloud(site.tags, { min_font: 1, max_font: 2.7, unit: 'em', orderby: 'name', show_count: true, count_class: 'folio-tag-count', transform: escape_html }) | safe }}
        </nav>
        {% else %}
            {% include "_partial/common/empty.njk" %}
        {% endif %}
    {% endif %}
</section>
{% endblock %}
