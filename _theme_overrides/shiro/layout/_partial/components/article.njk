{# Shared article structure for post.njk and page.njk.
   Optional variables set before include:
     - article_show_meta: whether to show date/category meta (default: true)
     - article_extra: extra HTML to insert after article content (e.g. post navigation) #}
{% from "_macro/ui.njk" import meta, render_tag with context %}
{# TOC view-model from page_feature_gates (single build_toc / cachedToc). #}
{% set article_toc = gates.toc if gates.toc else { shouldRender: false, content: page.content, html: '' } %}
{% set show_article_meta = article_show_meta if article_show_meta is defined else true %}
{% set article_extra_html = article_extra if article_extra is defined else "" %}

<article class="folio-article">
    <header class="folio-article-header">
        {# data-pagefind-body keeps the title searchable; data-pagefind-meta sets the result title. #}
        <h1 class="page-title" data-pagefind-body data-pagefind-meta="title">
            {{ escape_html(page.title) }}
        </h1>
        {% if show_article_meta or (page.tags and page.tags.length > 0) %}
        <div class="folio-post-meta folio-article-meta">
            {% if show_article_meta %}
            {{ meta(page, true, "folio-meta-details") }}
            {% endif %}
            {% if page.tags and page.tags.length > 0 %}
            <div class="folio-tags">
                {% for tag in page.tags.toArray() %}
                {{ render_tag(tag, false) }}
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% endif %}
    </header>

    {% if article_toc.shouldRender %}
    {% include "_partial/components/toc.njk" %}
    {% endif %}

    <div class="prose-shiro" data-pagefind-body>
        {{ default_image_loading(article_toc.content, 'eager') | safe }}
    </div>

    {{ article_extra_html | safe }}

    {# Containers only; scripts load from layout foot via comments/foot.njk. #}
    {% if gates.needsComments %}
    {% include "_partial/comments/index.njk" %}
    {% endif %}
</article>
