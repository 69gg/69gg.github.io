<article class="folio-entry">
    <a class="folio-entry-date" href="{{ attr_url(archive_url(date(post.date, 'YYYY'))) }}" aria-label="{{ escape_attr(date(post.date, 'YYYY年M月D日')) }}">
      <time class="folio-calendar" datetime="{{ escape_attr(date(post.date, 'YYYY-MM-DD')) }}" aria-hidden="true">
        <span>{{ date(post.date, 'MMM') }}</span>
        <span class="folio-day">{{ date(post.date, 'DD') }}</span>
        <span>{{ date(post.date, 'YYYY') }}</span>
      </time>
    </a>
    <div class="folio-entry-content">
        <header>
            <h2><a href="{{ href_for(post.path) }}">{{ escape_html(post.title) }}</a></h2>
            {% include "_partial/folio/entry-meta.njk" %}
        </header>
        <div class="prose-shiro folio-excerpt">
            {%- if post.summary is string and (post.summary | trim) -%}
                <p>{{ escape_html(post.summary | trim) }}</p>
            {%- else -%}
                {{ excerpt.content | safe }}
            {%- endif -%}
        </div>
        <a class="folio-read-link" href="{{ href_for(post.path) }}" aria-label="{{ escape_attr(__('index.read_more') + ': ' + post.title) }}">阅读全文 <span aria-hidden="true">⟶</span></a>
    </div>
</article>
