{% from "_macro/ui.njk" import icon_rss with context %}
<footer class="folio-footer" data-pagefind-ignore>
    <div class="folio-endmark" aria-hidden="true"><span></span>✧<span></span></div>
    <p class="folio-footer-note">{{ escape_html(theme.folio.note) }}</p>
    <nav class="folio-footer-links" aria-label="更多浏览方式">
        <a href="{{ href_for('/archives/') }}">归档</a>
        <a href="{{ href_for('/categories/') }}">分类</a>
        <a href="{{ href_for('/tags/') }}">标签</a>
        {% if gates.needsRss %}<a href="{{ attr_url(safe_resource_url_for(gates.rssPath, '/atom.xml')) }}" target="_blank" rel="noopener noreferrer">{{ icon_rss() }} RSS</a>{% endif %}
    </nav>
    <div class="folio-colophon">
        <p>© {{ escape_html(copyright_year(gates.siteConfig.since)) }} {{ escape_html(config.title) }}</p>
    </div>
    <p class="folio-build">{{ build_info() }}</p>
</footer>
