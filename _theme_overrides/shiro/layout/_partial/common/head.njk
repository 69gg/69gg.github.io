<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content="Hexo {{ escape_attr(hexo.version) }}" />
    {# FOUC theme script before blocking stylesheets (first-paint contract). #}
    {% include "_partial/common/head-theme.njk" %}
    {# Register before the incoming document's first rendering opportunity. #}
    <script{{ csp_nonce_attr(gates.shiroCspNonce) }} data-cfasync="false">
        (() => {
            const html = document.documentElement;
            const shiro = window.__shiro;
            shiro.folioSceneKey = {{ js_value(versioned_url('css/folio.css') + '|' + versioned_url('css/fonts.css') + '|' + versioned_url('js/folio-preload.js')) | safe }};
            try {
                const ready = JSON.parse(sessionStorage.getItem('folio:scene-ready') || 'null');
                shiro.folioWarm = ready?.key === shiro.folioSceneKey;
                shiro.folioFullFonts = shiro.folioWarm && ready.fullFonts;
            } catch (_) {}
            if (shiro.folioWarm) html.setAttribute('data-folio-navigation', '');
            else html.setAttribute('data-folio-loading', '');
            let timer;
            shiro.folioReady = new Promise((resolve) => {
                shiro.revealFolio = () => {
                    clearTimeout(timer);
                    if (document.body) document.body.inert = false;
                    html.removeAttribute('data-folio-loading');
                    resolve();
                };
            });
            // Never leave reading hidden if a request or the loader fails.
            const timeout = {{ js_value(config.theme_config.folio.preload_timeout | default(6000)) | safe }};
            if (shiro.folioWarm) shiro.revealFolio();
            else timer = setTimeout(shiro.revealFolio, timeout);
            // Watch preloads before their links are parsed. CSS consumes the
            // original requests; detached Images would consume them twice
            // when the HTTP cache is disabled.
            shiro.folioImagesReady = new Promise((resolve) => {
                let remaining = {{ folio_preloads() | length }};
                let failed = false;
                const settle = (event) => {
                    if (!event.target.matches?.('link[data-folio-preload]')) return;
                    if (event.type === 'error') failed = true;
                    if (--remaining > 0) return;
                    document.removeEventListener('load', settle, true);
                    document.removeEventListener('error', settle, true);
                    resolve(!failed);
                };
                document.addEventListener('load', settle, true);
                document.addEventListener('error', settle, true);
                if (!remaining) resolve(true);
            });
        })();
        window.addEventListener('pagereveal', (event) => {
            if (event.viewTransition) document.documentElement.setAttribute('data-folio-navigation', '');
        });
    </script>
    {% include "_partial/folio/preloads.njk" %}
    {# Run before optional deferred engines such as MathJax. #}
    <script defer{{ csp_nonce_attr(gates.shiroCspNonce) }} data-cfasync="false" src="{{ attr_url(versioned_url('js/folio-preload.js')) }}"></script>
    {% include "_partial/common/head-prefetch.njk" %}
    {% include "_partial/common/head-mathjax.njk" %}
    {% if page.layout == 'guestbook' %}
    {% include "_partial/noticeboard/head-meta.njk" %}
    {% else %}
    {% include "_partial/common/head-seo.njk" %}
    {% endif %}
    {% include "_partial/common/head-styles.njk" %}
</head>
